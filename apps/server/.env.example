OPENTASKS_APP_NAME=opentasks
OPENTASKS_APP_VERSION=0.1.0
OPENTASKS_STORAGE_DRIVER=postgres
OPENTASKS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/opentasks
OPENTASKS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/opentasks_test
OPENTASKS_AUTO_MIGRATE=true
OPENTASKS_SEED_DEMO_DATA=true
OPENTASKS_DEFAULT_LEASE_SECONDS=900
