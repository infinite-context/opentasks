# =====================================================================
# OpenTasks Environment Configuration
# =====================================================================

# Core
NODE_ENV=development
OPENTASKS_APP_NAME=opentasks
OPENTASKS_APP_VERSION=0.1.0

# Storage
OPENTASKS_STORAGE_DRIVER=sqlite
OPENTASKS_DATABASE_URL=./data/opentasks.db
OPENTASKS_AUTO_MIGRATE=true

# Transport
OPENTASKS_MCP_ENABLED=true
OPENTASKS_MCP_OVER_HTTP=true
OPENTASKS_HTTP_ENABLED=true
OPENTASKS_HTTP_PORT=3005

# Task defaults
OPENTASKS_DEFAULT_LEASE_SECONDS=900

# Learning pipeline - LLM summaries (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Learning pipeline - Local embeddings (Ollama native API)
OPENTASKS_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=256
